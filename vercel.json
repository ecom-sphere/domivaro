{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/police/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/zones",
      "destination": "/nos-zones/",
      "permanent": true
    },
    {
      "source": "/zones/",
      "destination": "/nos-zones/",
      "permanent": true
    },
    {
      "source": "/es/zonas",
      "destination": "/es/nuestras-zonas/",
      "permanent": true
    },
    {
      "source": "/es/zonas/",
      "destination": "/es/nuestras-zonas/",
      "permanent": true
    },
    {
      "source": "/en/areas",
      "destination": "/en/our-area/",
      "permanent": true
    },
    {
      "source": "/en/areas/",
      "destination": "/en/our-area/",
      "permanent": true
    }
  ]
}
